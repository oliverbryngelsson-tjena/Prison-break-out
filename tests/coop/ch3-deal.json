[
 {"on":"AB","until":"window.__app.game.begun && !window.__app.game.cutscenes.current","timeout":120000},
 {"on":"A","eval":"(() => { const g = window.__app.game; g.session.emit('flag', { k: 'talked', v: true }); g.session.emit('flag', { k: 'cash', v: true }); return 1; })()"},
 {"wait":800},
 {"on":"AB","eval":"(() => { const g = window.__app.game; const bp = g.chapter.bikeSpot(g.localChar); g.local.teleport(bp.pos.clone().add({ x: 0, y: 0.05, z: 1.0 }), Math.PI); return bp.pos.toArray(); })()"},
 {"wait":1200},
 {"on":"AB","press":"KeyE"},
 {"on":"AB","until":"window.__app.game.local.state === 'bike'","timeout":15000},
 {"on":"AB","until":"window.__app.game.chapter.flags.mounted_elias && window.__app.game.chapter.flags.mounted_jax","timeout":15000},
 {"on":"AB","hold":"KeyW","ms":7000},
 {"on":"AB","until":"window.__app.game.cutscenes.current && window.__app.game.cutscenes.current.id === 'cs3_dealer'","timeout":20000},
 {"on":"AB","check":{"name":"a short ride, then the fade to the deal","expr":"window.__app.game.cutscenes.current.id === 'cs3_dealer'"}},
 {"on":"AB","until":"window.__app.game.chapter.flags.phase === 'dealer' && !window.__app.game.cutscenes.current","timeout":60000},
 {"on":"AB","check":{"name":"guns laid out behind Dutch's car, walk over to pick","expr":"window.__app.game.local.state === 'free' && window.__app.game.interact.items.has('deal_guns')"}},
 {"on":"A","eval":"(() => { const g = window.__app.game; g.local.teleport(g.chapter.dealPos.clone().add({ x: 1.5, y: 0.05, z: 0 }), -Math.PI / 2); return 1; })()"},
 {"wait":1000},
 {"on":"A","press":"KeyE"},
 {"wait":600},
 {"on":"A","check":{"name":"weapon shop opens with seven weapons","expr":"document.querySelectorAll('.hud-shop .shop-item').length === 7"}},
 {"on":"A","eval":"(() => { const it = [...document.querySelectorAll('.hud-shop .shop-item')].find(e => /Grease Gun/.test(e.textContent)); it.click(); return 1; })()"},
 {"on":"AB","until":"window.__app.game.guns.loadout[window.__app.game.session.authority ? window.__app.game.localChar : window.__app.game.remoteChar] === 'smg'","timeout":10000},
 {"on":"AB","check":{"name":"host picked the Grease Gun SMG (seen on both)","expr":"Object.values(window.__app.game.guns.loadout).includes('smg')"}},
 {"on":"B","eval":"(() => { const g = window.__app.game; g.local.teleport(g.chapter.dealPos.clone().add({ x: -1.5, y: 0.05, z: 0 }), Math.PI / 2); return 1; })()"},
 {"wait":1000},
 {"on":"B","press":"KeyE"},
 {"wait":600},
 {"on":"B","eval":"(() => { const it = [...document.querySelectorAll('.hud-shop .shop-item')].find(e => /Shotgun/.test(e.textContent)); it.click(); return 1; })()"},
 {"on":"AB","until":"window.__app.game.cutscenes.current && window.__app.game.cutscenes.current.id === 'cs3_deal_done'","timeout":20000},
 {"on":"AB","check":{"name":"both picked: SMG and shotgun on both clients","expr":"Object.values(window.__app.game.guns.loadout).sort().join() === 'shotgun,smg'"}},
 {"on":"AB","until":"window.__app.state === 'end' || (window.__app.game && window.__app.game.state === 'ended')","timeout":120000},
 {"on":"AB","check":{"name":"picks carried into chapter 4's save","expr":"(() => { const s = JSON.parse(localStorage.getItem('pbo.save') || 'null'); return !s || !s.flags || Object.keys(s.flags).some(k => k.startsWith('carry_weapon')); })()"}}
]
