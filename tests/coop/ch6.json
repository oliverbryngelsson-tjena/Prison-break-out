 },
 {
  "on": "AB",
  "eval": "(() => { const g = window.__app.game; return { me: g.localChar, hp: Math.round(g.local.body.hp), remoteHp: Math.round(g.remote.body.hp), winner: g.chapter.flags.winner, cs: g.cutscenes.current && g.cutscenes.current.id, ls: g.local.state }; })()"
 },
 {
  "on": "AB",
  "check": {
   "name": "Elias wins the fight: winner agreed on both clients",
   "expr": "window.__app.game.chapter.flags.winner === 'elias'"
  }
 },
 {
  "on": "AB",
  "until": "window.__app.game.cutscenes.played.has('cs6_end_elias')",
  "timeout": 30000
 },
 {
  "on": "AB",
  "check": {
   "name": "Elias's ending cutscene plays on both",
   "expr": "window.__app.game.cutscenes.played.has('cs6_end_elias')"
  }
 },
 {
  "on": "AB",
  "until": "window.__app.state === 'end'",
  "timeout": 150000
 },
 {
  "on": "AB",
  "check": {
   "name": "game ends on both with the final screen",
   "expr": "document.querySelector('[data-screen=end].show') !== null"
  }
 },
 {
  "on": "AB",
  "check": {
   "name": "ending saved",
   "expr": "JSON.parse(localStorage.getItem('pbo.save')||'{}').endings?.includes('elias_lives')"
  }
 }
