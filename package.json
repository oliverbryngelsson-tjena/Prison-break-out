{
  "name": "prison-break-out",
  "version": "0.1.0",
  "description": "Two-player online co-op 3D prison escape action-adventure for mobile (Three.js + WebSocket rooms).",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.mjs --packages=external",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:server": "node tests/server.test.mjs",
    "test:e2e": "node tests/e2e-multiplayer.mjs",
    "assets:characters": "node tools/build-characters.mjs",
    "assets:anims": "node tools/build-anims.mjs",
    "test:coop": "node tools/coop.mjs",
    "test:soak": "node tools/soak.mjs",
    "credits": "node tools/credits-md.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverbryngelsson-tjena/Prison-break-out.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oliverbryngelsson-tjena/Prison-break-out/issues"
  },
  "homepage": "https://github.com/oliverbryngelsson-tjena/Prison-break-out#readme",
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.5",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "meshoptimizer": "^1.3.0",
    "peer": "^1.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "type": "module"
}
